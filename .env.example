# RAG MCP — infrastructure configuration
# Copy to .env and adjust for the target machine.

RAG_PORT=8000

POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me-strong-password

# One installation-private persistent root, outside the public repository.
# It will contain at least:
#   data/      uploaded blobs + extraction cache
#   postgres/  PostgreSQL/pgvector data
RAG_PRIVATE_PATH=../rag-private

LMSTUDIO_URL=http://192.168.1.10:1234

RAG_API_TOKEN=change-me-api-token

MCP_ENABLED=true
MCP_NAME=rag-server
MCP_ALLOWED_HOSTS=

LOG_LEVEL=INFO
UVICORN_WORKERS=1

# Optional Secure MCP Tunnel sidecar (leave both empty to disable).
# The tunnel-client profile should target http://app:8000/mcp from the Compose network.
RAG_TUNNEL_BINARY=
RAG_TUNNEL_DIR=
RAG_TUNNEL_BASE_IMAGE=node:24-bookworm-slim
RAG_TUNNEL_CONTAINER_NAME=rag-mcp-tunnel
